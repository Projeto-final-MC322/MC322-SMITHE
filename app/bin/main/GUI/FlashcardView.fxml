<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://github.com/fxml/1" fx:controller="FlashcardController">
   <children>
      <TabPane tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="Estudar Hoje">
               <content>
                  <VBox alignment="CENTER" spacing="20.0" style="-fx-padding: 30;">
                     <children>
                        <Label fx:id="lblContador" text="Cartões restantes: 0" />
                        <VBox fx:id="boxCartao" alignment="CENTER" onMouseClicked="#virarCartao" prefHeight="200.0" prefWidth="400.0" style="-fx-background-color: #ffffff; -fx-border-color: #bdc3c7; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20; -fx-cursor: hand;">
                           <children>
                              <Label fx:id="lblTextoCard" text="Clique em 'Iniciar' para começar" textAlignment="CENTER" wrapText="true">
                                 <font><Font size="18.0" /></font>
                              </Label>
                           </children>
                        </VBox>
                        <Button fx:id="btnIniciar" onAction="#iniciarEstudo" text="Iniciar Sessão" />
                        <HBox fx:id="boxNotas" alignment="CENTER" spacing="10.0" visible="false">
                           <children>
                              <Button onAction="#darNota1" text="1 ❌" />
                              <Button onAction="#darNota2" text="2 ⏳" />
                              <Button onAction="#darNota3" text="3 ☕" />
                              <Button onAction="#darNota4" text="4 👍" />
                              <Button onAction="#darNota5" text="5 🔥" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </Tab>
          <Tab text="Novo Flashcard">
               <content>
                  <VBox spacing="15.0" style="-fx-padding: 20;">
                     <children>
                        <Label text="Cadastrar Flashcard" textFill="#2c3e50"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <TextField fx:id="txtRegTitulo" placeholder="Título" />
                        <TextField fx:id="txtRegDisciplina" placeholder="Disciplina (Ex: Unicamp)" />
                        <TextField fx:id="txtRegFrente" placeholder="Pergunta (Frente)" />
                        <TextField fx:id="txtRegVerso" placeholder="Resposta (Verso)" />
                        <Button onAction="#cadastrarNovoCard" prefHeight="35.0" prefWidth="120.0" text="Salvar Card" />
                     </children>
                  </VBox>
               </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
</StackPane>
