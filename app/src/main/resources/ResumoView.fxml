<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<StackPane
    prefHeight="600.0" prefWidth="720.0"
    styleClass="fundo-padrao";"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://github.com/fxml/1"
    fx:controller="GUI.ResumoController">
    <ImageView fitWidth="500" preserveRatio="true" opacity="0.08" StackPane.alignment="CENTER">
        <image><Image url="/logo.png" /></image>
    </ImageView>
    <children>
        <VBox spacing="0" style="-fx-padding: 40; -fx-background-color: #131f11;">
            <children>

                <!-- CabeĆ§alho -->
                <VBox spacing="4" style="-fx-padding: 0 0 28 0;">
                    <children>
                        <Label
                            text="ANOTAÇÕES"
                            style="-fx-text-fill: #4f6b4c; -fx-font-size: 11px;" />
                        <Label
                            text="Criar novo resumo"
                            style="-fx-text-fill: #c8e6c4; -fx-font-size: 20px; -fx-font-weight: bold;" />
                    </children>
                </VBox>

                <!-- FormulĆ�rio -->
                <VBox spacing="14" maxWidth="560">
                    <children>

                        <!-- TĆ­tulo -->
                        <VBox spacing="5">
                            <children>
                                <Label
                                    text="TíTULO"
                                    style="-fx-text-fill: #6a8a66; -fx-font-size: 12px;" />
                                <TextField
                                    fx:id="txtTitulo"
                                    promptText="Ex: Pilares da POO"
                                    style="-fx-background-color: #1a2318; -fx-text-fill: #c8e6c4;
                                           -fx-border-color: #2d3d2a; -fx-border-radius: 8;
                                           -fx-background-radius: 8; -fx-padding: 10 14;
                                           -fx-font-size: 13px; -fx-prompt-text-fill: #3d5a3a;" />
                            </children>
                        </VBox>

                        <!-- Disciplina -->
                        <VBox spacing="5">
                            <children>
                                <Label
                                    text="Disciplina"
                                    style="-fx-text-fill: #6a8a66; -fx-font-size: 12px;" />
                                <TextField
                                    fx:id="txtDisciplina"
                                    promptText="Ex: Computação, Unicamp"
                                    style="-fx-background-color: #1a2318; -fx-text-fill: #c8e6c4;
                                           -fx-border-color: #2d3d2a; -fx-border-radius: 8;
                                           -fx-background-radius: 8; -fx-padding: 10 14;
                                           -fx-font-size: 13px; -fx-prompt-text-fill: #3d5a3a;" />
                            </children>
                        </VBox>

                        <!-- ConteĆŗdo -->
                        <VBox spacing="5">
                            <children>
                                <Label
                                    text="Conteúdo"
                                    style="-fx-text-fill: #6a8a66; -fx-font-size: 12px;" />
                                <TextArea
                                    fx:id="txtConteudo"
                                    promptText="Escreva o seu resumo aqui..."
                                    prefHeight="240.0"
                                    wrapText="true"
                                    style="-fx-background-color: #1a2318; -fx-text-fill: #c8e6c4;
                                           -fx-border-color: #2d3d2a; -fx-border-radius: 8;
                                           -fx-background-radius: 8; -fx-padding: 10 14;
                                           -fx-font-size: 13px; -fx-prompt-text-fill: #3d5a3a;" />
                            </children>
                        </VBox>

                        <!-- BotĆ£o salvar -->
                        <Button
                            text="Salvar e Exportar .TXT"
                            onAction="#salvarEExportar"
                            prefHeight="42" prefWidth="220"
                            style="-fx-background-color: #4a7c45; -fx-text-fill: #e8f5e4;
                                   -fx-font-size: 14px; -fx-font-weight: bold;
                                   -fx-background-radius: 10; -fx-cursor: hand;
                                   -fx-border-width: 0;">
                            <VBox.margin><Insets top="6" /></VBox.margin>
                        </Button>

                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</StackPane>