<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #131f11;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://github.com/fxml/1" fx:controller="GUI.MapaMentalController">
    <children>
        <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #131f11;">
            <children>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="🧠 MAPAS MENTAIS" style="-fx-text-fill: #c8e6c4; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtDiscMapa" promptText="Disciplina (Ex: Física I)" prefWidth="200" styleClass="text-field" />
                        <TextField fx:id="txtTituloMapa" promptText="Novo Tópico Raiz" prefWidth="200" styleClass="text-field" />
                        <Button text="Carregar / Criar" onAction="#carregarOuCriarMapa" styleClass="button" />
                    </children>
                </HBox>

                <HBox spacing="15" VBox.vgrow="ALWAYS">
                    <children>
                        <Pane fx:id="paneDesenho" HBox.hgrow="ALWAYS" style="-fx-background-color: #0f1a0e; -fx-border-color: #2d3d2a; -fx-border-radius: 12; -fx-background-radius: 12;" />
                        
                        <VBox fx:id="boxEdicao" prefWidth="280" spacing="12" style="-fx-background-color: #1a2318; -fx-border-color: #2d3d2a; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 15;" disable="true">
                            <children>
                                <Label text="Conteúdo do Tópico" style="-fx-text-fill: #8fd685; -fx-font-weight: bold; -fx-font-size: 14px;" />
                                <Label fx:id="lblNomeTopico" text="Selecione um tópico no mapa..." style="-fx-text-fill: #c8e6c4; -fx-font-style: italic;" />
                                
                                <TextArea fx:id="txtConteudoTopico" wrapText="true" promptText="Escreva as definições, fórmulas e resumos deste tópico aqui..." VBox.vgrow="ALWAYS" styleClass="text-area" />
                                
                                <Button text="💾 Salvar Conteúdo" onAction="#salvarConteudoNo" maxWidth="Infinity" styleClass="button" />
                                <Separator style="-fx-background-color: #2d3d2a;" />
                                <Button text="➕ Adicionar Subtópico" onAction="#adicionarFilho" maxWidth="Infinity" style="-fx-background-color: #4a7c45; -fx-text-fill: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;" />
                                <Button text="🗑 Remover Tópico" onAction="#removerNo" maxWidth="Infinity" style="-fx-background-color: #8c2a2a; -fx-text-fill: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>