<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #131f11;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://github.com/fxml/1" fx:controller="GUI.MapaMentalController">
    <children>
        <VBox fx:id="telaListagem" spacing="20" style="-fx-padding: 30; -fx-background-color: #131f11;">
            <children>
                <Label text="🧠 GALERIA DE MAPAS MENTAIS" style="-fx-text-fill: #c8e6c4; -fx-font-size: 22px; -fx-font-weight: bold;" />
                <HBox spacing="10">
                    <TextField fx:id="txtNovaDisciplina" promptText="Nova Disciplina (Ex: Cálculo I)" prefWidth="200" styleClass="text-field" />
                    <TextField fx:id="txtNovoTitulo" promptText="Nome do Tópico Raiz" prefWidth="200" styleClass="text-field" />
                    <Button text="Criar Novo Mapa" onAction="#criarMapaDaListagem" styleClass="button" />
                </HBox>
                <Separator style="-fx-background-color: #2d3d2a;" />
                
                <ScrollPane fitToWidth="true" style="-fx-background: #131f11; -fx-background-color: transparent;">
                    <FlowPane fx:id="gridMapas" hgap="15" vgap="15" />
                </ScrollPane>
            </children>
        </VBox>

        <VBox fx:id="telaMapa" spacing="10" style="-fx-padding: 20; -fx-background-color: #131f11;" visible="false">
            <children>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Button text="⬅ Voltar" onAction="#voltarParaListagem" styleClass="button" />
                        <Label fx:id="lblTituloMapaAberto" text="Disciplina - Mapa" style="-fx-text-fill: #c8e6c4; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="🔄 Reorganizar Mapa" onAction="#reorganizarMapa" style="-fx-background-color: #2a3d4a; -fx-text-fill: white; -fx-border-radius: 5; -fx-background-radius: 5;" />
                        <TextField fx:id="txtNovoTopico" promptText="Nome do Novo Subtópico" prefWidth="200" styleClass="text-field" />
                        <Button text="➕ Adicionar Tópico" onAction="#adicionarTopico" styleClass="button" />
                    </children>
                </HBox>

                <HBox spacing="15" VBox.vgrow="ALWAYS">
                    <children>
                        <Pane fx:id="paneDesenho" HBox.hgrow="ALWAYS" style="-fx-background-color: #0f1a0e; -fx-border-color: #2d3d2a; -fx-border-radius: 12; -fx-background-radius: 12;" />
                        
                        <VBox fx:id="boxEdicao" prefWidth="280" spacing="12" style="-fx-background-color: #1a2318; -fx-border-color: #2d3d2a; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 15;" disable="true">
                            <children>
                                <Label text="Conteúdo do Tópico" style="-fx-text-fill: #8fd685; -fx-font-weight: bold; -fx-font-size: 14px;" />
                                <Label fx:id="lblNomeTopico" text="Selecione um tópico no mapa..." style="-fx-text-fill: #c8e6c4; -fx-font-style: italic;" wrapText="true" />
                                
                                <TextArea fx:id="txtConteudoTopico" wrapText="true" promptText="Escreva todas as definições, fórmulas e resumos deste tópico aqui..." VBox.vgrow="ALWAYS" styleClass="text-area" />
                                
                                <Button text="💾 Salvar Conteúdo" onAction="#salvarConteudoNo" maxWidth="Infinity" styleClass="button" />
                                <Separator style="-fx-background-color: #2d3d2a;" />
                                <Button text="🗑 Remover Tópico" onAction="#removerNo" maxWidth="Infinity" style="-fx-background-color: #8c2a2a; -fx-text-fill: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-cursor: hand; -fx-border-width: 0;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>