<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f1f8e9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://github.com/fxml/1" fx:controller="GUI.MapaMentalController">
<ImageView fitWidth="500" preserveRatio="true" opacity="0.08" StackPane.alignment="CENTER">
        <image><Image url="@logo.png" /></image>
    </ImageView>
    <children>
        <VBox fx:id="telaListagem" spacing="20" style="-fx-padding: 30; -fx-background-color: #f1f8e9;">
            <children>
                <Label text="🧠 GALERIA DE MAPAS MENTAIS" style="-fx-text-fill: #1b5e20; -fx-font-size: 22px; -fx-font-weight: bold;" />
                <HBox spacing="10">
                    <TextField fx:id="txtNovaDisciplina" promptText="Nova Disciplina (Ex: Cálculo I)" prefWidth="200" style="-fx-background-color: white; -fx-border-color: #81c784; -fx-border-radius: 5;" />
                    <TextField fx:id="txtNovoTitulo" promptText="Nome do Tópico Raiz" prefWidth="200" style="-fx-background-color: white; -fx-border-color: #81c784; -fx-border-radius: 5;" />
                    <Button text="Criar Novo Mapa" onAction="#criarMapaDaListagem" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                </HBox>
                <Separator style="-fx-background-color: #a5d6a7;" />
                
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f1f8e9;">
                    <FlowPane fx:id="gridMapas" hgap="15" vgap="15" />
                </ScrollPane>
            </children>
        </VBox>

        <StackPane fx:id="telaMapa" visible="false">
            
            <ImageView fitWidth="500" preserveRatio="true" opacity="0.1" StackPane.alignment="CENTER">
                <image>
                    <Image url="@logo.png" />
                </image>
            </ImageView>

            <VBox spacing="10" style="-fx-padding: 20;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Button text="⬅ Voltar" onAction="#voltarParaListagem" style="-fx-background-color: #a5d6a7; -fx-text-fill: #1b5e20; -fx-font-weight: bold; -fx-cursor: hand;" />
                        <Label fx:id="lblTituloMapaAberto" text="Disciplina - Mapa" style="-fx-text-fill: #1b5e20; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="🔄 Reorganizar Mapa" onAction="#reorganizarMapa" style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;" />
                        <TextField fx:id="txtNovoTopico" promptText="Nome do Novo Subtópico" prefWidth="200" style="-fx-background-color: white; -fx-border-color: #81c784; -fx-border-radius: 5;" />
                        <Button text="➕ Adicionar Tópico" onAction="#adicionarTopico" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </children>
                </HBox>

                <HBox spacing="15" VBox.vgrow="ALWAYS">
                    <children>
                        <Pane fx:id="paneDesenho" HBox.hgrow="ALWAYS" style="-fx-background-color: #f1f8e9; -fx-border-radius: 12; -fx-background-radius: 12;" />
                        
                        <VBox fx:id="boxEdicao" prefWidth="280" spacing="12" style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-border-color: #a5d6a7; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 15;" disable="true">
                            <children>
                                <Label text="Conteúdo do Tópico" style="-fx-text-fill: #2e7d32; -fx-font-weight: bold; -fx-font-size: 14px;" />
                                <Label fx:id="lblNomeTopico" text="Selecione um tópico no mapa..." style="-fx-text-fill: #1b5e20; -fx-font-style: italic;" wrapText="true" />
                                
                                <TextArea fx:id="txtConteudoTopico" wrapText="true" promptText="Escreva as definições, fórmulas e resumos deste tópico aqui..." VBox.vgrow="ALWAYS" style="-fx-control-inner-background: white;" />
                                
                                <Button text="💾 Salvar Conteúdo" onAction="#salvarConteudoNo" maxWidth="Infinity" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                                <Separator style="-fx-background-color: #a5d6a7;" />
                                <Button text="🗑 Remover Tópico" onAction="#removerNo" maxWidth="Infinity" style="-fx-background-color: #e57373; -fx-text-fill: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-cursor: hand; -fx-border-width: 0;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </VBox>
        </StackPane>
    </children>
</StackPane>