<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="painelPrincipal" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f1f8e9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://github.com/fxml/1" fx:controller="GUI.TelaPrincipal">
    <left>
        <VBox spacing="15" style="-fx-background-color: #c8e6c4; -fx-padding: 20;" prefWidth="220">
            <VBox alignment="CENTER" spacing="5">
                <ImageView fitWidth="120" preserveRatio="true">
                    <image>
                        <Image url="@/logo.png" />
                    </image>
                </ImageView>
                <Label text="SMITHE" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1b5e20;" />
            </VBox>
            
            <Separator style="-fx-background-color: #81c784;" />
            
            <Button text="Mapas Mentais" onAction="#abrirMapasMentais" maxWidth="Infinity" style="-fx-background-color: #81c784; -fx-text-fill: #1b5e20; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;" />
            <Button text="Flashcards" onAction="#abrirFlashcards" maxWidth="Infinity" style="-fx-background-color: #81c784; -fx-text-fill: #1b5e20; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;" />
            <Button text="Resumos" onAction="#abrirResumos" maxWidth="Infinity" style="-fx-background-color: #81c784; -fx-text-fill: #1b5e20; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;" />
            <Button text="Pomodoro" onAction="#abrirPomodoro" maxWidth="Infinity" style="-fx-background-color: #81c784; -fx-text-fill: #1b5e20; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;" />
        </VBox>
    </left>
    
    <center>
        <StackPane fx:id="Conteudo" style="-fx-padding: 15;">
            <VBox alignment="CENTER" spacing="15">
                <ImageView fitWidth="220" preserveRatio="true" opacity="0.8">
                    <image>
                        <Image url="@/logo.png" />
                    </image>
                </ImageView>
                <Label text="Bem-Vindo ao SMITHE!" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1b5e20;" />
                <Label text="★ Study Management in Tech Engineering ★" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1b5e20;" />

                <Label text="Selecione qual vai ser o seu estudo de hoje no menu lateral." style="-fx-font-size: 16px; -fx-text-fill: #388e3c; -fx-font-style: italic;" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>