<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?> <BorderPane fx:id="painelPrincipal" prefHeight="600.0" prefWidth="900.0" stylesheets="@smithe.css" styleClass="fundo-padrao" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://github.com/fxml/1" fx:controller="GUI.TelaPrincipal">
    <left>
        <VBox spacing="15" styleClass="menu-padrao" style="-fx-padding: 20;" prefWidth="220">
            <VBox alignment="CENTER" spacing="5">
                <ImageView fitWidth="100" preserveRatio="true">
                    <image><Image url="@logo.png" /></image>
                </ImageView>
                <Label text="SMITHE" style="-fx-font-size: 24px; -fx-font-weight: bold;" styleClass="texto-padrao" />
                <Label fx:id="lblNivel" text="Nível 1 | 0 BZ" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 5 10; -fx-background-radius: 15;" styleClass="botao-padrao" />
                
                <Button fx:id="btnTema" text="[Modo Escuro / Claro]" onAction="#alternarTema" styleClass="botao-padrao">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
            </VBox>
            <Separator styleClass="linha-mapa" />
            
            <Button text="★ Revisões" onAction="#abrirRevisoes" maxWidth="Infinity" styleClass="botao-padrao" style="-fx-padding: 10; -fx-font-family: 'Segoe UI Emoji', 'sans-serif';" />
            <Button text="★ Mapas Mentais" onAction="#abrirMapasMentais" maxWidth="Infinity" styleClass="botao-padrao" style="-fx-padding: 10; -fx-font-family: 'Segoe UI Emoji', 'sans-serif';" />
            <Button text="★ Flashcards" onAction="#abrirFlashcards" maxWidth="Infinity" styleClass="botao-padrao" style="-fx-padding: 10; -fx-font-family: 'Segoe UI Emoji', 'sans-serif';" />
            <Button text="★ Resumos" onAction="#abrirResumos" maxWidth="Infinity" styleClass="botao-padrao" style="-fx-padding: 10; -fx-font-family: 'Segoe UI Emoji', 'sans-serif';" />
            <Button text="★ Pomodoro" onAction="#abrirPomodoro" maxWidth="Infinity" styleClass="botao-padrao" style="-fx-padding: 10; -fx-font-family: 'Segoe UI Emoji', 'sans-serif';" />
        </VBox>
    </left>
    <center>
        <StackPane fx:id="Conteudo" style="-fx-padding: 15;">
            <VBox alignment="CENTER" spacing="15">
                <ImageView fitWidth="220" preserveRatio="true" opacity="0.8">
                    <image><Image url="@logo.png" /></image>
                </ImageView>
                <Label text="Bem-Vindo ao SMITHE!" style="-fx-font-size: 32px; -fx-font-weight: bold;" styleClass="texto-padrao" />
                <Label text="★ Study Management in Tech Engineering ★" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI Emoji', 'sans-serif';" styleClass="texto-mut" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>