<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<StackPane prefHeight="600.0" prefWidth="720.0" styleClass="fundo-padrao" stylesheets="@smithe.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://github.com/fxml/1" fx:controller="GUI.PomodoroController">
    <ImageView fitWidth="500" preserveRatio="true" opacity="0.08" StackPane.alignment="CENTER">
        <image><Image url="@logo.png" /></image>
    </ImageView>
    <children>
        <VBox alignment="CENTER" spacing="0" style="-fx-padding: 40; -fx-background-color: transparent;">
            <children>
                <VBox alignment="CENTER" spacing="4" style="-fx-padding: 0 0 32 0;">
                    <children>
                        <Label text="CRONÔMETRO POMODORO" styleClass="texto-mut" style="-fx-font-size: 11px; -fx-font-family: 'System';" />
                        <Label text="Foco total. Um bloco de cada vez." styleClass="texto-padrao" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    </children>
                </VBox>

                <VBox alignment="CENTER" spacing="8" maxWidth="380" styleClass="card-padrao" style="-fx-padding: 40 60 36 60;">
                    <children>
                        <HBox alignment="CENTER" spacing="0">
                            <children>
                                <Label fx:id="lblTipoSessao" text="● SESSÃO DE FOCO" styleClass="texto-padrao" style="-fx-font-size: 11px; -fx-font-family: 'System';" />
                            </children>
                        </HBox>

                        <Label fx:id="lblTempo" text="25:00" styleClass="texto-padrao" style="-fx-font-size: 72px; -fx-font-weight: bold; -fx-font-family: 'System';" />

                        <ProgressBar fx:id="progressTimer" prefWidth="200" prefHeight="4" progress="0" style="-fx-accent: #4caf50;" />

                        <Label fx:id="lblSessoes" text="Sessões concluídas: 0" styleClass="texto-mut" style="-fx-font-size: 12px; -fx-padding: 6 0 0 0;" />

                        <HBox alignment="CENTER" spacing="12" style="-fx-padding: 16 0 0 0;">
                            <children>
                                <Button fx:id="btnIniciar" text="Iniciar" onAction="#cliqueIniciar" prefHeight="40" prefWidth="110" styleClass="botao-padrao" />
                                <Button fx:id="btnPausar" text="Pausar" onAction="#cliquePausar" prefHeight="40" prefWidth="110" styleClass="botao-padrao" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Label text="💡 Clique em Iniciar e mantenha o foco por 25 minutos" styleClass="texto-mut" style="-fx-font-size: 12px; -fx-padding: 24 0 0 0;" />
            </children>
        </VBox>
    </children>
</StackPane>