<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<!-- CORRIGIDO: Usa styleClass em vez de cores fixas -->
<StackPane styleClass="fundo-padrao" stylesheets="@smithe.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://github.com/fxml/1" fx:controller="GUI.RevisoesController">
    <ImageView fitWidth="500" preserveRatio="true" opacity="0.08" StackPane.alignment="CENTER">
        <image><Image url="/logo.png" /></image> <!-- Sem barra -->
    </ImageView>
    <VBox spacing="20" style="-fx-padding: 30;">
        <Label text="📅 Revisões Programadas para Hoje" styleClass="texto-padrao" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
        <Label text="Ganhe +15 Bazingas por cada Mapa/Resumo revisto!" styleClass="texto-mut" style="-fx-font-size: 14px;" />
        
        <ListView fx:id="listaRevisoes" VBox.vgrow="ALWAYS" styleClass="card-padrao" />
        
        <Button text="✔ Marcar Selecionado como Revisado (+15 BZ)" onAction="#marcarComoRevisado" maxWidth="Infinity" styleClass="botao-padrao" style="-fx-padding: 12; -fx-cursor: hand;" />
    </VBox>
</StackPane>